# =============================================================================
# INTERVIEWAI PRO - SERVER ENVIRONMENT CONFIGURATION
# =============================================================================
#
# SECURITY BEST PRACTICES:
# - Never commit actual secrets to version control
# - Use different secrets for development, staging, and production
# - Rotate API keys every 90 days
# - Use strong, randomly generated secrets (e.g., openssl rand -base64 32)
#
# Copy this file to .env and fill in your values
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4028

# Logging level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# =============================================================================
# FIREBASE ADMIN (REQUIRED)
# =============================================================================
# Option 1: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Inline JSON (for container deployments)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Firebase Realtime Database URL (REQUIRED)
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_REF.asia-southeast1.firebasedatabase.app

# =============================================================================
# SECURITY SECRETS
# =============================================================================
# Secret for email verification code HMAC (32+ chars recommended)
# Generate with: openssl rand -base64 32
EMAIL_VERIFICATION_CODE_SECRET=your-32-char-or-longer-secret-here

# JWT Secret (if using custom JWT signing)
# JWT_SECRET=your-jwt-secret-here

# =============================================================================
# IMAGE/CONTENT MODERATION (OPTIONAL)
# =============================================================================
# Sightengine API for image moderation
# Sign up at: https://sightengine.com
# Free tier: 2000 operations/month
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# =============================================================================
# AI/LLM CONFIGURATION
# =============================================================================
# Local Ollama server (free, runs locally)
# Setup: ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Local Whisper Server for speech recognition
WHISPER_SERVER_URL=http://localhost:5000
WHISPER_MODEL=large-v3

# =============================================================================
# WEBRTC CONFIGURATION
# =============================================================================
STUN_SERVER=stun:stun.l.google.com:19302
# TURN_SERVER=turn:your-turn-server.com:3478
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Gmail SMTP only
FROM_NAME=InterviewAI Pro
FROM_EMAIL=your-email@gmail.com
CONTACT_INBOX_EMAIL=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Gmail setup:
# 1. Enable 2-factor authentication for your Google account.
# 2. Generate an App Password: https://myaccount.google.com/apppasswords

# =============================================================================
# BILLING/PAYMENTS (FUTURE)
# =============================================================================
# Stripe integration (not yet implemented)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# API KEY ROTATION REMINDERS
# =============================================================================
# FIREBASE_SERVICE_ACCOUNT: Rotate in Firebase Console > Project Settings > Service Accounts
# SIGHTENGINE: Contact Sightengine support for key rotation
# SMTP_PASS (Gmail): Generate new App Password at myaccount.google.com/apppasswords
