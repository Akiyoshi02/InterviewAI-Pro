# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4028

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_REF.asia-southeast1.firebasedatabase.app

# Sightengine (image moderation)
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Setup: ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Local Whisper Server (already running)
WHISPER_SERVER_URL=http://localhost:5000
WHISPER_MODEL=large-v3

# WebRTC Configuration
STUN_SERVER=stun:stun.l.google.com:19302

# Logging
LOG_LEVEL=info

# Email Configuration
EMAIL_PROVIDER=console
FROM_EMAIL=akiyoshiyapa@gmail.com
FROM_NAME=InterviewAI Pro
CONTACT_INBOX_EMAIL=support@aiinterviewpro.com
SENDGRID_API_KEY=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

# SMTP Configuration (For Gmail, Outlook, etc.)
# Gmail: Enable 2FA, then create App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Outlook Example:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password
